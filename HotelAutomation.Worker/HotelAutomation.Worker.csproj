<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- UserSecretsId: enables `dotnet user-secrets` for dev-time secret storage.
         The AccessToken MUST be stored here, NEVER in appsettings.json. -->
    <UserSecretsId>HotelAutomation-Worker-29A4F1E2-B3C7-4D8A-9E0F-1A2B3C4D5E6F</UserSecretsId>
    <!-- Suppress the default worker service launchSettings; we control startup explicitly -->
    <RootNamespace>HotelAutomation.Worker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Polly: resilience and retry policies for HTTP calls (defence-in-depth) -->
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <!-- All four library projects: Worker is the ONLY project allowed to reference all of them -->
    <ProjectReference Include="..\HotelAutomation.Core\HotelAutomation.Core.csproj" />
    <ProjectReference Include="..\HotelAutomation.Data\HotelAutomation.Data.csproj" />
    <ProjectReference Include="..\HotelAutomation.Connectors.WhatsApp\HotelAutomation.Connectors.WhatsApp.csproj" />
    <ProjectReference Include="..\HotelAutomation.Connectors.Pms\HotelAutomation.Connectors.Pms.csproj" />
  </ItemGroup>
  <Target Name="CopyReactApp" BeforeTargets="Build">
    <ItemGroup>
      <ReactAppFiles Include="..\HotelAutomation.UI\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactAppFiles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" />
  </Target>

</Project>
