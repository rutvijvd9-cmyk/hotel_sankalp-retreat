<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- UserSecretsId: enables `dotnet user-secrets` for dev-time secret storage.
         The AccessToken MUST be stored here, NEVER in appsettings.json. -->
    <UserSecretsId>HotelAutomation-Worker-29A4F1E2-B3C7-4D8A-9E0F-1A2B3C4D5E6F</UserSecretsId>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0'">Exe</OutputType>
    <!-- Suppress the default worker service launchSettings; we control startup explicitly -->
    <RootNamespace>HotelAutomation.Worker</RootNamespace>
    <!-- Windows Forms: required for NotifyIcon (system tray) -->
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">true</UseWindowsForms>
    <!-- Embed hotel.ico as the exe icon shown in Explorer / taskbar -->
    <ApplicationIcon>hotel.ico</ApplicationIcon>
    <!-- Embed all native C++ DLLs (QuestPdfSkia, e_sqlite3, qpdf) into single-file exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Polly: resilience and retry policies for HTTP calls (defence-in-depth) -->
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

  <ItemGroup>
    <!-- All four library projects: Worker is the ONLY project allowed to reference all of them -->
    <ProjectReference Include="..\HotelAutomation.Core\HotelAutomation.Core.csproj" />
    <ProjectReference Include="..\HotelAutomation.Data\HotelAutomation.Data.csproj" />
    <ProjectReference Include="..\HotelAutomation.Connectors.WhatsApp\HotelAutomation.Connectors.WhatsApp.csproj" />
    <ProjectReference Include="..\HotelAutomation.Connectors.Pms\HotelAutomation.Connectors.Pms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Include hotel.ico so it is copied to the publish output folder -->
    <Content Include="hotel.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <Target Name="CopyReactApp" BeforeTargets="Build">
    <ItemGroup>
      <ReactAppFiles Include="..\HotelAutomation.UI\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactAppFiles)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)" />
  </Target>

</Project>
