    "WatchFolder":        "{AppDir}\\PDFs",
    "PrinterOutputFile":  "{AppDir}\\PDFs\\sankalp_bill.pdf",
    "VirtualPrinterName": "TheSankalpRetreat",
    "ArchiveFolder":      "{AppDir}\\PDFs\\Processed",
    "ArchiveProcessed":   true,
    "DefaultEventType":   "CheckOut",
    "FileReadDelayMs":    800
  },

