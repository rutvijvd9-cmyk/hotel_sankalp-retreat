  // ── PMS Connector: "Pdf" = Virtual Printer Bridge ─────────────────────────
  // Set to "Manual" to use the manual entry mode, "Database" to poll an external DB.
  "PmsConnectorType": "Pdf",

  // ── PDF Print Bridge Configuration ────────────────────────────────────────
  // WatchFolder    : where the virtual printer saves PDFs (must match printer port config)
  // ArchiveFolder  : processed PDFs are moved here for audit trail
  // DefaultEventType: "CheckOut" fires the checkout WhatsApp message
  "PdfBridge": {
    "WatchFolder":        "{AppDir}\\PDFs",
    "PrinterOutputFile":  "{AppDir}\\PDFs\\sankalp_bill.pdf",
    "VirtualPrinterName": "Scalifts",
    "ArchiveFolder":      "{AppDir}\\PDFs\\Processed",
    "ArchiveProcessed":   true,
    "DefaultEventType":   "CheckOut",
    "FileReadDelayMs":    800
  },

  // ── Legacy: kept for reference, not used when PmsConnectorType = "Pdf" ────
